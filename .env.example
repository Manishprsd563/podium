# Copy to .env and fill in real values. Never commit .env (it is gitignored).
# Every variable below is read somewhere in agent/, analysis/, web/, evidence/, or scripts/ --
# see README.md "Credential hygiene" for how they flow (server-side only, never exposed to the browser).

# --- LiveKit (required) ---
# Cloud project dashboard: https://cloud.livekit.io -> your project -> Settings -> Keys.
# Read by: the agent worker (livekit-agents CLI, agent/session_agent.py + agent/gate0_agent.py),
# web/serve.py's /token endpoint, and evidence/e2_duplex.py's real-orchestrator harness.
# Also implicitly authenticates LiveKit Inference (the coach/judge LLM calls) -- no separate key needed.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Rime TTS (required) ---
# Organizer-provided key or your own: https://rime.ai -> dashboard -> API keys.
# Read by: the rime.TTS LiveKit plugin (agent/session_agent.py, WebSocket /ws3, live coach speech),
# analysis/render.py (REST POST /v1/rime-tts, offline V1/V2/V3 clips), and the evidence/e1 + e3 scripts.
RIME_API_KEY=your_rime_api_key

# Optional overrides of the shipped, measured config (GATE0.md); safe to leave unset.
# Read by: agent/session_agent.py, agent/gate0_agent.py.
RIME_MODEL=mistv3
RIME_SPEAKER=astra

# --- Deepgram STT (required) ---
# https://console.deepgram.com -> API Keys.
# Read by: the deepgram.STT LiveKit plugin (agent/session_agent.py, nova-3, filler_words=true),
# and the evidence/e1 + e3 scripts (same nova-3 config, used to verify fillers/markup in transcripts).
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Coach / judge LLM (optional overrides) ---
# Both are LiveKit Inference model IDs, not separate API keys -- authenticated by LIVEKIT_API_KEY/SECRET
# above. Change only to swap models; see GATE0.md for why these two were chosen.
# Read by: agent/llm_config.py.
COACH_MODEL=google/gemma-4-31b-it
JUDGE_MODEL=openai/gpt-5.4-mini
